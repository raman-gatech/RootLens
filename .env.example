# Copy this file to .env only when running the API outside Docker Compose.
ROOTLENS_DATABASE_URL=postgresql+asyncpg://rootlens:rootlens@localhost:5432/rootlens
ROOTLENS_ENVIRONMENT=development
ROOTLENS_LOG_LEVEL=INFO
ROOTLENS_DOCS_ENABLED=true
# Production must enable auth, mount a digest-only credential file, and set an
# explicit JSON trusted-host list. See docs/production-deployment.md.
ROOTLENS_AUTH_ENABLED=false
# ROOTLENS_AUTH_CREDENTIALS_FILE=/run/secrets/rootlens-auth/credentials.json
# ROOTLENS_TRUSTED_HOSTS=["rootlens.example.com"]
ROOTLENS_OTLP_ENDPOINT=http://localhost:4317
ROOTLENS_TELEMETRY_ENABLED=true
ROOTLENS_PROMETHEUS_URL=http://localhost:9090
ROOTLENS_TEMPO_URL=http://localhost:3200
ROOTLENS_LOKI_URL=http://localhost:3100
ROOTLENS_QUERY_TIMEOUT_SECONDS=10
ROOTLENS_QUERY_MAX_RETRIES=2
ROOTLENS_QUERY_MAX_RESPONSE_BYTES=10485760
ROOTLENS_QUERY_MAX_CONCURRENCY=8
ROOTLENS_DATABASE_POOL_SIZE=10
ROOTLENS_DATABASE_MAX_OVERFLOW=10
ROOTLENS_DATABASE_POOL_TIMEOUT_SECONDS=10
ROOTLENS_TOPOLOGY_TRACE_LIMIT=100
ROOTLENS_AGENT_PROVIDER=deterministic
ROOTLENS_OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY is read by Compose and passed only to the RootLens API.
ROOTLENS_REMEDIATION_EXECUTION_ENABLED=false
# Kubernetes defaults to in-cluster discovery and service-account credentials.
