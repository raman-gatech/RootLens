# RootLens overrides for the pinned OpenTelemetry Demo environment.
DEMO_VERSION=3.0.0
ROOTLENS_POSTGRES_DB=rootlens
ROOTLENS_POSTGRES_USER=rootlens
ROOTLENS_POSTGRES_PASSWORD=rootlens
ROOTLENS_DATABASE_URL=postgresql+asyncpg://rootlens:rootlens@rootlens-db:5432/rootlens
ROOTLENS_ENVIRONMENT=development
ROOTLENS_LOG_LEVEL=INFO
ROOTLENS_OTLP_ENDPOINT=http://otel-collector:4317
ROOTLENS_TELEMETRY_ENABLED=true
ROOTLENS_PROMETHEUS_URL=http://prometheus:9090
ROOTLENS_TEMPO_URL=http://tempo:3200
ROOTLENS_LOKI_URL=http://loki:3100
